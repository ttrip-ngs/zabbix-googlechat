googlechat:
  # Google Chat Webhook URL
  # 環境変数 GCHAT_WEBHOOK_URL で上書き可能
  webhook_url: ""
  # HTTPリクエストタイムアウト（秒）
  timeout: 10
  # 送信失敗時の最大リトライ回数
  max_retries: 3
  # リトライ間隔（秒）- 指数バックオフの基準値
  retry_delay: 1.0
  # メッセージスタイル: detailed / medium / compact / text
  #   detailed: 2セクション・項目ごと2行表示（情報量重視・既定）
  #   medium  : 2セクション維持・項目を1行に圧縮
  #   compact : カード1枚に集約（ヘッダー + 本文 + ボタン）
  #   text    : カードを使わないプレーンテキスト（最小スペース）
  # 環境変数 GCHAT_CARD_STYLE で上書き可能。
  # Zabbixアクションのメッセージ本文に CARD_STYLE=compact を書くとアクション単位で上書き可能。
  card_style: detailed

  # --- Chat API で送信する場合（復旧時に障害メッセージを更新する） ---
  # space を設定すると Webhook ではなく Chat API で送信する。
  # 手順は docs/ZABBIX_SETUP.md の8章を参照。
  # 環境変数 GCHAT_SPACE / GCHAT_CREDENTIALS_FILE で上書き可能。
  # {ALERT.SENDTO} に spaces/XXXX を設定するとユーザーメディア単位で上書き可能。
  # space: "spaces/XXXXXXXX"
  # サービスアカウント鍵（JSON）。zabbix ユーザーだけが読める権限(600)にする
  # credentials_file: /etc/zabbix-googlechat/service-account.json
  # メッセージIDの接頭辞（client-<接頭辞>-<EVENT.ID>）。英小文字・数字・ハイフン20文字以内。
  # 同じスペースに複数の Zabbix から送る場合は Zabbix ごとに変える
  # message_id_prefix: zbx

zabbix:
  # ZabbixサーバーのベースURL
  url: "https://zabbix.example.com"

logging:
  # ログレベル: DEBUG, INFO, WARNING, ERROR
  level: INFO
  # ログファイルパス（省略時は標準出力）
  # file: /var/log/zabbix-googlechat/notify.log
