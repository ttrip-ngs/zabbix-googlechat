# Google Chat Webhook URL
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=XXXXX&token=XXXXX

# Chat API で送信する場合（Webhook の代わり。復旧時に障害メッセージを更新する）
# GCHAT_SPACE=spaces/XXXXXXXX
# GCHAT_CREDENTIALS_FILE=/etc/zabbix-googlechat/service-account.json

# Zabbix Base URL
ZABBIX_URL=https://zabbix.example.com

# Timeout for HTTP requests (seconds)
GCHAT_TIMEOUT=10

# Max retries for failed requests
GCHAT_MAX_RETRIES=3

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file path (optional, leave empty for stdout)
# LOG_FILE=/var/log/zabbix-googlechat/notify.log
